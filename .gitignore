# --- Файлы операционной системы ---
.DS_Store        # Mac OS
Thumbs.db        # Windows
desktop.ini      # Windows

# --- Файлы сред разработки (IDE) ---
.vscode/         # Visual Studio Code
.idea/           # JetBrains (PyCharm, IntelliJ, WebStorm)
*.swp            # Vim
*.sublime-*      # Sublime Text

# --- Зависимости и сборки ---
# Node / JavaScript
node_modules/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.env
.venv
venv/
env/
.virtualenv/

# Java
*.class
*.jar
*.war
target/
build/
.gradle/

# C / C++
*.o
*.out
*.exe
*.app

# --- Локальные конфигурационные файлы ---
# (их нельзя пушить, так как там могут быть пароли или личные пути)
*.log
*.local
*.secret
config/local.yml
secrets/

# --- Файлы данных и резервные копии ---
*.sqlite3
*.db
*.bak
*.tmp
*.temp
*.swp
*~
\#*\#
.\#*

# --- Временные файлы редакторов ---
*.sublime-workspace